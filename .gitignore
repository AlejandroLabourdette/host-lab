# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Secrets. The contract is deploy/.env.example; the real file never leaves the host.
.env
deploy/**/.env

# Local state written by the platform at runtime
*.local.json

# Generated by `hostlab compose`. The instance file is the source of truth and
# is committed; this is its output, regenerated per host, and a committed copy
# would go stale the moment the instance file changed.
deploy/**/compose.yaml
