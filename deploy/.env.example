# The secret contract. Copy to .env on the host and fill it in.
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored and must stay that way. Nothing in this file is a
# real value; every one of them is a placeholder.

# --- Valheim ---------------------------------------------------------------
# The world name must match the save directory name exactly, capitalisation
# included. A mismatch does not error: the server generates a fresh empty world
# next to the real one. See docs/save-data-and-backups.md.
VALHEIM_SERVER_NAME=Midgard
VALHEIM_WORLD_NAME=Midgard

# At least 5 characters, and it must NOT appear inside the server name or the
# world name, case-insensitively. Breaking either rule does not look like a
# password problem: the server logs "Error bad password:" and exits. The
# manifest declares both rules, so the platform refuses before the server does.
VALHEIM_PASSWORD=

# 1 lists the server in the community browser, 0 hides it. A hidden server is
# still joinable by address. The password is not access control; for a private
# world use permittedlist.txt, remembering that a non-empty one excludes
# everyone not on it.
VALHEIM_PUBLIC=0

# --- Telegram, for read-only status (ADR 0006 stage 1) ---------------------
# From BotFather. The platform only ever sends and edits: it never calls
# getUpdates and registers no webhook, so this bot cannot be instructed. That
# is what bounds the cost of leaking this token. See ADR 0008.
TELEGRAM_BOT_TOKEN=

# Negative. A plain group looks like -5352257660; a supergroup looks like
# -1001234567890. Which one you have matters, because Telegram promotes a group
# to a supergroup on its own and THE ID CHANGES WHEN IT DOES. See the failure
# note in docs/remote-control.md: publication stops and nothing reports it.
TELEGRAM_CHAT_ID=

# --- Backups (ADR 0003) -----------------------------------------------------
# restic repository for the off-site copy, for example:
#   b2:my-valheim-backups:valheim
#   s3:https://<account>.r2.cloudflarestorage.com/my-valheim-backups
RESTIC_REPOSITORY=

# Lose this and the off-site backup is an encrypted blob nobody can open.
# It must ALSO live somewhere that is not this host and not this repository.
# That is not paranoia: the whole point of the off-site copy is surviving the
# loss of this machine, and a password stored only on it does not.
RESTIC_PASSWORD=

# Backblaze B2
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Cloudflare R2, or any other S3-compatible backend. Use these instead of the
# B2 pair, not as well.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
